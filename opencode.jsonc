{
  "$schema": "https://opencode.ai/config.json",
  // Skills locais sao descobertas em .opencode/skills/<id>/SKILL.md.
  // Sem instalar plugins, catalogos remotos ou credenciais automaticamente.
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "pelotavision-*", "effect": "allow" }
  ]
}
